{
  "$schema": "https://docs.liara.ir/schema/liara.json",
  "next": {
    "nodeVersion": "22",
    "mirror": true,
    "installDevDependencies": true
  },
  "port": 3000,
  "build": {
    "location": "iran"
  },
  "healthCheck": {
    "command": "CMD curl --fail http://localhost:3000/ || exit 1",
    "interval": 30,
    "timeout": 15,
    "retries": 3,
    "startPeriod": 20
  }
}
