{
  "name": "abzaro",
  "version": "0.1.0",
  "private": true,
  "description": "Abzaro (ابزارو) — free online tools for Persian-speaking users.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepare:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "test:e2e": "node scripts/e2e-check.mjs",
    "test:e2e:all": "node scripts/e2e-all-tools.mjs",
    "build:static": "ABZARO_EXPORT=1 next build && node scripts/prune-static.mjs",
    "package:static": "node scripts/package-static.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "prune:static": "node scripts/prune-static.mjs",
    "prebuild:static": "node scripts/copy-ffmpeg.mjs",
    "remove-auth": "node scripts/remove-auth.mjs --git"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/ffmpeg": "0.12.10",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dompurify": "^3.4.18",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
