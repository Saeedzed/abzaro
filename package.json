    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.1",
